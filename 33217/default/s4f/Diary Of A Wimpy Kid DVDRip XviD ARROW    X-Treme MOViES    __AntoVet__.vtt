01:18:10.263 --> 01:18:12.390



01:18:12.465 --> 01:18:14.831



01:18:14.901 --> 01:18:16.994



01:18:17.069 --> 01:18:19.333



01:18:19.405 --> 01:18:21.600



01:18:21.674 --> 01:18:23.801



01:18:23.876 --> 01:18:26.071



01:18:26.145 --> 01:18:28.340



01:18:28.414 --> 01:18:30.644



01:18:42.061 --> 01:18:44.325
